HL_MASTER_ACCOUNT=0xYourMasterWallet
HL_API_PRIVATE_KEY=YourAuthorizedTestnetAPIWalletPrivateKey
HL_TESTNET=true
AUTO_TRANSFER_SPOT=false
# Optional public wallet addresses for research; empty enables large-print discovery.
RESEARCH_WALLETS=

# Strategy (see docs/STRATEGY.md). Provisional default until scripts/strategy_research.py
# has been run on downloaded history; it prints the settings it selects.
STRATEGY=donchian
STRATEGY_PARAMS='{"entry": 20, "exit": 10}'
STRATEGY_INTERVAL=1h
TRADE_COINS=BTC,ETH,SOL

# Sizing: equity lost if a stop is hit, plus leverage caps on notional exposure.
RISK_PER_TRADE_PCT=0.5
MAX_POSITIONS=3
MAX_LEVERAGE_PER_POSITION=3
MAX_GROSS_LEVERAGE=5
EXCHANGE_LEVERAGE=10

# Drawdown breaker: flatten at this drop from the peak, wait, re-base the peak, resume.
DRAWDOWN_LIMIT_PCT=5
BREAKER_COOLDOWN_HOURS=12
BREAKER_AUTO_RESET=true
# 0 disables the optional daily loss gate (blocks new entries until the next UTC day).
DAILY_LOSS_LIMIT_PCT=0
MAX_DAILY_ENTRIES=30

# Execution bounds: IOC entries fill up to this far through the touch; stop fills are bounded too.
ENTRY_SLIPPAGE_PCT=0.3
STOP_SLIPPAGE_PCT=3
DASHBOARD_PORT=8080
